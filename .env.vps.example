APP_DOMAIN=example.com

POSTGRES_DB=vv_delivery
POSTGRES_USER=vv
POSTGRES_PASSWORD=change_me_long_random_password

ADMIN_PASSWORD=change_me_manager_password
ADMIN_MANAGER_LOGIN=manager
ADMIN_MANAGER_PASSWORD=change_me_manager_password
ADMIN_STAFF_LOGIN=admin
ADMIN_STAFF_PASSWORD=change_me_staff_password
# Temporary test mode only: set to 1 to allow admin password dev and partner login dev/dev.
# Keep 0 or remove before real launch.
VV_DEV_LOGIN=0

# Keep disabled in production: reviews require a signed-in customer and a delivered order.
# Set to 1 only for an explicitly requested local presentation.
VV_DEMO_REVIEWS=0

PUBLIC_SITE_URL=https://vmestevkusnee.ru
CUSTOMER_AUTH_SECRET=change_me_long_random_customer_auth_secret
OAUTH_SUCCESS_PATH=/

# Customer login providers. Fill after creating apps in VK ID and Yandex ID.
# Redirect URLs:
# https://vmestevkusnee.ru/api/auth/vk/callback
# https://vmestevkusnee.ru/api/auth/yandex/callback
# https://vmestevkusnee.ru/api/auth/telegram/callback
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# YooKassa. Use credentials from the store settings, never expose the secret to the browser.
# Webhook URL: https://vmestevkusnee.ru/api/payments/yookassa/webhook
# The public checkout remains disabled until both values are present.
YOOKASSA_MODE=production
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Enable only after confirming fiscalization and the VAT code with the accountant/OFD.
# VAT codes supported by YooKassa in 2026: 1..12. Do not guess this value.
YOOKASSA_RECEIPT_ENABLED=0
YOOKASSA_VAT_CODE=
# Enable only if recurrent payments are activated in the YooKassa contract.
YOOKASSA_SAVE_PAYMENT_METHOD_ENABLED=0

# SMTP for required email confirmation during customer onboarding.
EMAIL_VERIFICATION_REQUIRED=1
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

VAPID_PUBLIC_KEY=public_key_from_web_push
VAPID_PRIVATE_KEY=private_key_from_web_push
VAPID_SUBJECT=mailto:owner@example.com

# Internal operational notifications in the MAX chat.
MAX_NOTIFICATIONS_ENABLED=1
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_BASE_URL=https://platform-api2.max.ru
# Temporarily set to 1 while admins test demo orders and SLA reminders.
MAX_MONITOR_DEMO_ORDERS=0
