# Add these blocks to /opt/apps/proxy/Caddyfile on the VPS.

vmestevkusnee.ru {
  encode zstd gzip
  reverse_proxy vv-delivery-app:3000
}

www.vmestevkusnee.ru {
  redir https://vmestevkusnee.ru{uri} permanent
}

delivery.vmestevkusnee.ru {
  encode zstd gzip

  request_body {
    max_size 2MB
  }

  reverse_proxy vv-delivery-app:3000
}

partners.vmestevkusnee.ru {
  encode zstd gzip
  reverse_proxy vv-delivery-app:3000
}

admin.vmestevkusnee.ru {
  encode zstd gzip
  reverse_proxy vv-delivery-app:3000
}
